# Shared local defaults. Copy to .env when needed.
# Values from the shell environment take priority over this file.

OFFLINE_MODE=true
DATABASE_URL=postgresql+psycopg://dc_agent@127.0.0.1/dc_agent
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_COMPATIBILITY_MODE=modern
STRUCTURED_QUERY_ENABLED=true
UNIFIED_KNOWLEDGE_ROUTING_ENABLED=false
WORD_FACTUAL_QA_ENABLED=false
STRUCTURED_IMPLICIT_SUMMARY_MAX_METRICS=12
CLICKHOUSE_QUERY_USER=dc_agent_query
CLICKHOUSE_QUERY_PASSWORD_FILE=./secrets/clickhouse-query-password
CLICKHOUSE_INGEST_USER=dc_agent_ingest
CLICKHOUSE_INGEST_PASSWORD_FILE=./secrets/clickhouse-ingest-password
STRUCTURED_QUERY_TIMEOUT_SECONDS=4
STRUCTURED_INGEST_BATCH_ROWS=50000
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0
CLAMAV_HOST=127.0.0.1
EMBEDDING_SERVICE_URL=http://127.0.0.1:8081
LLAMA_CPP_EMBEDDING_URL=http://127.0.0.1:8083
LLAMA_CPP_EMBEDDING_PATH=/v1/embeddings
LLAMA_CPP_EMBEDDING_MODEL=bge-m3-Q4_K_M.gguf
LLAMA_CPP_EMBEDDING_TIMEOUT_SECONDS=15
LLAMA_CPP_EMBEDDING_BATCH_MAX_ITEMS=32
RERANKER_SERVICE_URL=http://127.0.0.1:8082
RETRIEVAL_MODE=qwen3
RERANKER_ENABLED=true
RETRIEVAL_SHADOW_PERCENT=10
RETRIEVAL_CANARY_PERCENT=0
RETRIEVAL_PERMISSION_TAGS=公开
RETRIEVAL_KNOWLEDGE_BASE_ID=default
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RETRIEVAL_RERANK_TOP_K=8
RETRIEVAL_DEGRADED_RERANK_TOP_K=4
RETRIEVAL_FINAL_TOP_K=4
RETRIEVAL_RRF_K=60
RETRIEVAL_TOTAL_TIMEOUT_SECONDS=20
QDRANT_COLLECTION_ALIAS=knowledge_chunks_current
EMBEDDING_RUNTIME=llama_cpp
EMBEDDING_MODEL_NAME=bge-m3-Q4_K_M.gguf
EMBEDDING_MODEL_VERSION=llama-cpp-bge-m3-q4km-v1
# Operator action: replace with the sha256sum of the target BGE-M3 GGUF file.
# Store the normalized 64 lowercase hex characters without the optional sha256: prefix.
EMBEDDING_MODEL_SHA256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Operator action: before deployment, call the target Ollama /api/embed endpoint.
# Measure len(embeddings[0]) in the response and replace the example value below.
EMBEDDING_MODEL_DIMENSIONS=1024
EMBEDDING_MODEL_NORMALIZED=true
EMBEDDING_ENCODING_PROFILE_SHA256=52fd367c0a46ecfffc3fcf7f688d0a9e6c80f26cacf772eeeee78cc7f6c16254
EMBEDDING_PROTOCOL_VERSION=v1
RERANKER_RUNTIME=llama_cpp
RERANKER_MODEL_NAME=bge-reranker-v2-m3-Q4_K_M.gguf
RERANKER_MODEL_VERSION=llama-cpp-bge-reranker-v2-m3-q4km-v1
# Operator action: replace with the sha256sum of the target BGE-Reranker GGUF file.
# Store the normalized 64 lowercase hex characters without the optional sha256: prefix.
RERANKER_MODEL_SHA256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
RERANKER_PROMPT_PROFILE_SHA256=6f7fb308e56ddbdb5e2cf8536141b9d038e5fe69e12791c9a5142e6e68ef0cc9
RERANKER_PROTOCOL_VERSION=v1
RERANKER_BATCH_MAX_ITEMS=32
RERANKER_QUEUE_MAX_ITEMS=192
RERANKER_BATCH_WAIT_MS=10
LLAMA_CPP_RERANKER_URL=http://127.0.0.1:8080
LLAMA_CPP_RERANKER_PATH=/v1/rerank
LLAMA_CPP_RERANKER_MODEL=bge-reranker-v2-m3-Q4_K_M.gguf
LLAMA_CPP_RERANK_TIMEOUT_SECONDS=10
LLAMA_CPP_RERANK_BATCH_MAX_ITEMS=32
# Compatibility values used only when the selected runtime is ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen2.5:0.5b
OLLAMA_EMBEDDING_PATH=/api/embed
OLLAMA_RERANKER_MODEL=qwen2.5:3b
OLLAMA_GENERATE_PATH=/api/generate
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT_SECONDS=15
OLLAMA_RERANK_FORMAT_JSON=true
OLLAMA_RERANK_BATCH_MAX_ITEMS=8
OLLAMA_RERANK_NUM_PREDICT=512
SPARSE_MODEL_DIR=qdrant-bm25
SPARSE_MODEL_ROOT=./models/qdrant-bm25
SPARSE_PROFILE_SHA256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
LLAMA_SERVER_URL=http://127.0.0.1:11434
LLM_HEALTH_PATH=/api/version
# Development only. create_production_app rejects template and mock providers.
LLM_PROVIDER=template
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=local-offline
LLM_MODEL=local-model

# Native Ubuntu Ollama example. Calls deepseek-llm:7b directly and does not use Physoc.
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama-local
# LLM_MODEL=deepseek-llm:7b
# LLAMA_SERVER_URL=http://127.0.0.1:11434
# LLM_HEALTH_PATH=/api/version
# OFFLINE_MODE=true

# BEGIN PHYSOC DEEPSEEK EXAMPLE
# Physoc DeepSeek example. Physoc 模式无需 LLM_API_KEY。
# LLM_PROVIDER=physoc_deepseek
# LLM_API_BASE=http://127.0.0.1:8090
# LLM_STREAM_PATH=/api/physoc/deepseeks/stream
# LLM_MODEL=my_deepseek_r1_7b
# END PHYSOC DEEPSEEK EXAMPLE
RAW_DATA_ROOT=./data/raw
PARQUET_ROOT=./data/parquet
MODEL_ROOT=./models
MODEL_SLOTS=2
DEPENDENCY_TIMEOUT_SECONDS=2.0

# Minimum combined retrieval score required before evidence is passed to DCAgent.
RETRIEVAL_MIN_SCORE=2.2

# Frontend dev-server proxy target. Both frontend projects default to this value.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
